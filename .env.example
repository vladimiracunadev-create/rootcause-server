# Generate a token with: cargo run -p rootcause-server -- token
ROOTCAUSE_API_TOKEN=replace-with-at-least-32-random-characters
ROOTCAUSE_BIND=127.0.0.1:8080
ROOTCAUSE_DATABASE_URL=sqlite://rootcause.db
ROOTCAUSE_LOG=info

# Agent settings
ROOTCAUSE_SERVER_URL=http://127.0.0.1:8080
ROOTCAUSE_AGENT_INTERVAL_SECONDS=30
