# ---------------------------------------------------------------- servidor --
# Genera el token con: rootcause-server token
# Nunca lo pongas en la línea de comandos: queda en el historial y en `ps`.
ROOTCAUSE_API_TOKEN=reemplaza-por-al-menos-32-caracteres-aleatorios

# Escucha solo en loopback. Cámbialo únicamente después de poner TLS delante.
ROOTCAUSE_BIND=127.0.0.1:8080
ROOTCAUSE_DATABASE_URL=sqlite://rootcause.db
ROOTCAUSE_LOG=rootcause_server=info

# Perímetro propio del plano de control.
ROOTCAUSE_RATE_LIMIT_PER_MINUTE=600
ROOTCAUSE_LOCKOUT_THRESHOLD=10
ROOTCAUSE_LOCKOUT_SECONDS=300
ROOTCAUSE_MAX_BODY_KIB=1024

# Cuántos días se conservan telemetría, presión de autenticación y eventos de
# defensa. Los incidentes y la auditoría no caducan: son la evidencia.
ROOTCAUSE_RETENTION_DAYS=30

# Solo si hay un proxy inverso delante. Sin proxy, cualquiera elegiría qué
# dirección se limita y se bloquea.
# ROOTCAUSE_TRUST_FORWARDED_FOR=true

# Política de detección versionada junto al despliegue.
# ROOTCAUSE_POLICY_FILE=/etc/rootcause/policy.json

# Registros estructurados, útil detrás de un recolector.
# ROOTCAUSE_JSON_LOGS=true

# ------------------------------------------------------------------ agente --
ROOTCAUSE_SERVER_URL=http://127.0.0.1:8080
ROOTCAUSE_AGENT_INTERVAL_SECONDS=30
ROOTCAUSE_AGENT_AUTH_WINDOW_MINUTES=15

# Solo recursos, sin superficie de seguridad. El servidor lo declara como
# brecha para que nadie confunda "no se recolectó" con "no hay nada".
# ROOTCAUSE_AGENT_METRICS_ONLY=true

# Archivos vigilados además de los del sistema, separados por coma.
# ROOTCAUSE_WATCH_FILES=/srv/app/.env,/etc/nginx/sites-enabled/app
