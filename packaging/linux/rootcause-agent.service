[Unit]
Description=RootCause native telemetry agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=rootcause-agent
Group=rootcause-agent
EnvironmentFile=/etc/rootcause/agent.env
ExecStart=/usr/local/bin/rootcause-agent
Restart=on-failure
RestartSec=10s
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
CapabilityBoundingSet=
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
